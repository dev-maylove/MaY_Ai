<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MaYAi" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#090A12</item>
        <item name="android:navigationBarColor">#090A12</item>
        <item name="android:windowBackground">#090A12</item>
    </style>

    <!-- Cold-start window before SplashActivity inflates -->
    <style name="Theme.MaYAi.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
